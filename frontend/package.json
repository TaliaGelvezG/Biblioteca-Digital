{
    "name": "frontend",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "jest --runInBand",
        "test:watch": "jest --watch",
        "test:ci": "jest --runInBand --ci --coverage"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "dependencies": {
        "@angular/common": "^20.1.0",
        "@angular/compiler": "^20.1.0",
        "@angular/core": "^20.1.0",
        "@angular/forms": "^20.1.0",
        "@angular/platform-browser": "^20.1.0",
        "@angular/router": "^20.1.0",
        "jwt-decode": "^4.0.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular/build": "^20.1.6",
        "@angular/cli": "^20.1.6",
        "@angular/compiler-cli": "^20.1.0",
        "@angular/platform-browser-dynamic": "^21.0.3",
        "@types/jest": "^29.5.0",
        "@types/node": "^20.0.0",
        "jest": "^29.6.0",
        "jest-preset-angular": "^14.2.0",
        "ts-jest": "^29.1.0",
        "typescript": "~5.8.2"
    }
}
